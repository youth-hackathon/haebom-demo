# 이 파일을 .env 로 복사해 값을 채웁니다. .env 와 secrets/ 는 저장소에 올라가지 않습니다.

# 시연 페이지의 비밀번호. 밖으로 열 때는 반드시 넣습니다. 비우면 비밀번호 없이 열립니다.
DEMO_PASSWORD=
DEMO_USER=haebom

# 어디에 열지. 이 컴퓨터에서만 볼 때는 127.0.0.1, 다른 컴퓨터에서 보게 하려면 0.0.0.0
WEB_BIND=127.0.0.1
WEBRTC_BIND=127.0.0.1
WEB_PORT=6080
WEB_TLS_PORT=6443

# https 인증서를 둘 폴더(cert.pem, key.pem). 비어 있으면 자체 서명한 것을 만들어 넣습니다(브라우저가 경고를 보여 줍니다).
TLS_DIR=./secrets/tls

# 모델 키와 음성 키는 따로 둡니다 (secrets/ 폴더를 만들고 아래 두 파일을 넣습니다).
#   secrets/artemis.env   LETSUR_API_KEY=... 와 OPENROUTER_API_KEY=...   (haebom-artemis 의 relay/.env.example 과 같은 형식)
#   secrets/tts.env       TTS_ENGINE=gemini 와 GEMINI_API_KEY=...   (앱은 언제나 Gemini 음성을 청합니다)
ARTEMIS_ENV=./secrets/artemis.env
TTS_ENV=./secrets/tts.env

# 폰 대수와 한 대의 사양. 화면을 CPU로 그리므로 폰의 속도는 CPU 수가 정합니다. 쉬는 폰은 CPU를 거의 쓰지 않습니다.
CF_DEVICES=4
CF_CPUS=8
CF_MEMORY_MB=4096

# 매뉴얼에 없는 요청에 artemis가 답하는 방식: jev 또는 baseline
APP_GUIDE_MODE=jev

# 폰의 잠금이 풀리는 때: 아무것도 누르지 않은 시간(초). 페이지가 열려 있는 동안에는 이것 말고는 풀리지 않습니다.
LEASE_IDLE_S=600

# 다른 곳에 띄운 음성 서버를 쓸 때만 적습니다. 비우면 이 compose 의 tts 를 씁니다.
APP_TTS_BASE=

# 이 파일을 .env 로 복사해 값을 채웁니다. .env 와 secrets/ 는 저장소에 올라가지 않습니다.

# 시연 페이지의 비밀번호. 밖으로 열 때는 반드시 넣습니다. 비우면 비밀번호 없이 열립니다.
DEMO_PASSWORD=
DEMO_USER=haebom

# 어디에 열지. 이 컴퓨터에서만 볼 때는 127.0.0.1, 다른 컴퓨터에서 보게 하려면 0.0.0.0
WEB_BIND=127.0.0.1
WEBRTC_BIND=127.0.0.1
WEB_PORT=6080
WEB_TLS_PORT=6443

# 모델 키와 TTS 키는 따로 둡니다 (없으면 secrets/ 폴더를 만들고 아래 두 파일을 넣습니다).
#   secrets/artemis.env   LETSUR_API_KEY=...            (haebom-artemis 의 relay/.env.example 과 같은 형식)
#   secrets/tts.env       GEMINI_API_KEY=... 와 TTS_ENGINE=gemini   (없으면 baseline 엔진)
ARTEMIS_ENV=./secrets/artemis.env
TTS_ENV=./secrets/tts.env

# 기기 사양. 화면은 CPU로 그리므로 해상도가 낮을수록 부드럽습니다.
CF_CPUS=8
CF_MEMORY_MB=8192

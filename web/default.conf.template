# 밖으로 여는 것은 이 서버뿐입니다 (WebRTC 영상·소리·입력이 오가는 포트는 기기 컨테이너가 따로 엽니다).
#   /haebom/              시연 페이지
#   /haebom/api/...       시연 API 컨테이너: 폰 목록, 폰 고르기와 반납, 안내 시작, 진행 기록
#   /devices/<폰>/...      기기 컨테이너의 Cuttlefish operator: 그 폰의 화면(client.html)과 WebRTC 신호.
#                         그 폰을 쓰고 있는 브라우저만 지나갑니다(시연 API에 물어봅니다).
#   /infra_config         WebRTC 설정 (폰 화면이 읽습니다)
#   그 밖                 없음. operator의 다른 화면(기기 목록 등)은 내보내지 않습니다.
# DEMO_PASSWORD가 있으면 모든 경로에 비밀번호가 걸립니다 (10-auth.sh).
# 80은 http, 443은 https(자체 서명)입니다. 브라우저는 https나 localhost에서만 마이크를 허용합니다.
map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
    listen 80;
    listen 443 ssl;
    server_name _;
    ssl_certificate     /etc/nginx/tls/cert.pem;
    ssl_certificate_key /etc/nginx/tls/key.pem;
    include /etc/nginx/haebom-auth.conf;

    # 컨테이너 이름은 요청이 올 때 찾습니다. 기기가 아직 뜨지 않았어도 이 서버는 뜹니다.
    resolver 127.0.0.11 valid=5s;
    set $device https://${DEVICE_HOST}:1443;
    set $api    http://${API_HOST}:8790;

    location = / { return 302 /haebom/; }
    location /haebom/ {
        alias /var/www/haebom/;
        index index.html;
        add_header Cache-Control "no-store";
    }
    location /haebom/api/ {
        rewrite ^/haebom/api/(.*)$ /$1 break;
        proxy_pass $api;
        proxy_read_timeout 90s;
    }
    # nginx만 부르는 길은 밖에서 부르지 못하게 막습니다.
    location = /haebom/api/allow { return 404; }

    # 이 요청을 보낸 브라우저가 그 폰을 쓰고 있는지 시연 API에 묻습니다. 쿠키가 같이 갑니다.
    location = /_lease {
        internal;
        proxy_pass $api/allow;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
    }

    location /devices/ {
        auth_request /_lease;
        # client.html에 tune.js를 끼워 넣습니다 (압축된 응답에는 못 넣으므로 압축을 끕니다).
        proxy_set_header Accept-Encoding "";
        sub_filter '<head>' '<head><script src="/haebom/tune.js"></script>';
        sub_filter_once on;
        proxy_pass $device;
        proxy_ssl_verify off;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
    location = /infra_config {
        proxy_pass $device;
        proxy_ssl_verify off;
        proxy_set_header Host $host;
    }
    location / { return 404; }
}

[Unit]
Description=haebom emulator %i: noVNC web gateway
PartOf=haebom-emu@%i.target
After=haebom-vnc@%i.service

[Service]
User=haebom
SupplementaryGroups=kvm
Environment=HOME=/home/haebom
ExecStart=/home/haebom/haebom/bin/haebom-part.sh web %i
Restart=always
RestartSec=3

[Install]
WantedBy=haebom-emu@%i.target

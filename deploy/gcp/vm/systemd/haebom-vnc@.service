[Unit]
Description=haebom emulator %i: x11vnc (localhost only)
PartOf=haebom-emu@%i.target
After=haebom-emulator@%i.service
Requires=haebom-emulator@%i.service

[Service]
User=haebom
SupplementaryGroups=kvm
Environment=HOME=/home/haebom
ExecStart=/home/haebom/haebom/bin/haebom-part.sh vnc %i
Restart=always
RestartSec=3
TimeoutStartSec=1500

[Install]
WantedBy=haebom-emu@%i.target
